# Copy this file to .env and fill in values as needed.
# .env is not committed to source control (see .gitignore handling of secrets
# below) -- never commit real API keys.

# Base URL of the CKAN instance to audit.
CKAN_URL=https://data.ca.gov

# Optional: CKAN API key/token. Only needed to include private datasets
# visible to your user/organization. Leave blank for public-only access.
CKAN_API_KEY=

# Page size used for package_search pagination (CKAN typically caps at 1000).
CKAN_ROWS_PER_PAGE=1000

# Per-request timeout, in seconds.
CKAN_TIMEOUT=30

# Number of retries for transient HTTP errors (429/5xx).
CKAN_MAX_RETRIES=3

# Whether to request private datasets (requires CKAN_API_KEY with access).
CKAN_INCLUDE_PRIVATE=true

# Directory used to store on-disk snapshot cache.
CACHE_DIR=.cache
